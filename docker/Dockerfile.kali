FROM kalilinux/kali-rolling AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# ── System tools disponibles en Kali vía apt ──────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    whois \
    dnsutils \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    git \
    curl \
    wget \
    libimage-exiftool-perl \
    libmagic1 \
    mat2 \
    poppler-utils \
    file \
    binutils \
    ca-certificates \
    whatweb \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ── Herramientas OSINT disponibles en repos de Kali (opcionales) ─────────────
# Si no están en el repo se ignoran — el runner las omite gracefully
RUN apt-get update && apt-get install -y --no-install-recommends \
    subfinder 2>/dev/null || true && \
    rm -rf /var/lib/apt/lists/*

# ── Python virtual environment ────────────────────────────────────────────────
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# ── Project dependencies (incluye mcp, fastapi, httpx Python lib, etc.) ───────
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Herramientas OSINT Python — cada una en capa separada para cache óptimo ───
# sherlock y maigret (búsqueda de usernames)
RUN pip install --no-cache-dir sherlock-project maigret || \
    echo "WARNING: sherlock/maigret install failed — username_recon degraded"

# holehe (email service check)
RUN pip install --no-cache-dir holehe || \
    echo "WARNING: holehe install failed — email_reputation degraded"

# theHarvester (domain/email OSINT) — PyPI package is a fake placeholder; install from source
RUN git clone --depth=1 https://github.com/laramies/theHarvester.git /tmp/theHarvester && \
    pip install --no-cache-dir /tmp/theHarvester && \
    rm -rf /tmp/theHarvester || \
    echo "WARNING: theHarvester install failed — domain_recon degraded"

# trufflehog (secret detection via entropy)
RUN pip install --no-cache-dir trufflehog 2>/dev/null || \
    echo "WARNING: trufflehog install failed — breach_workflow degraded"

# ── Go-based tools via binary download ────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends unzip 2>/dev/null \
    && rm -rf /var/lib/apt/lists/*

# httpx CLI (HTTP probing)
RUN curl -sL "https://github.com/projectdiscovery/httpx/releases/latest/download/httpx_linux_amd64.zip" \
    -o /tmp/httpx.zip 2>/dev/null && \
    cd /tmp && unzip -q httpx.zip httpx 2>/dev/null && \
    mv /tmp/httpx /usr/local/bin/httpx && \
    chmod +x /usr/local/bin/httpx && \
    rm -f /tmp/httpx.zip || \
    echo "WARNING: httpx CLI install failed — web probing degraded"

# gitleaks (secret detection) — asset filename includes version so resolve tag first
RUN GITLEAKS_VER=$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest \
        | grep '"tag_name"' | head -1 | sed 's/.*"v\([^"]*\)".*/\1/') && \
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VER}/gitleaks_${GITLEAKS_VER}_linux_x64.tar.gz" \
        -o /tmp/gitleaks.tar.gz && \
    tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks && \
    chmod +x /usr/local/bin/gitleaks && \
    rm -f /tmp/gitleaks.tar.gz || \
    echo "WARNING: gitleaks install failed — breach_workflow degraded"

# phoneinfoga (phone number OSINT)
RUN curl -fsSL "https://github.com/sundowndev/phoneinfoga/releases/latest/download/phoneinfoga_Linux_x86_64.tar.gz" \
    -o /tmp/phoneinfoga.tar.gz 2>/dev/null && \
    tar -xzf /tmp/phoneinfoga.tar.gz -C /tmp 2>/dev/null && \
    mv /tmp/phoneinfoga /usr/local/bin/phoneinfoga && \
    chmod +x /usr/local/bin/phoneinfoga && \
    rm -f /tmp/phoneinfoga.tar.gz || \
    echo "WARNING: phoneinfoga install failed — phone_workflow degraded"

# ── Application code ──────────────────────────────────────────────────────────
COPY mcp_server/ ./mcp_server/
COPY osint_api/ ./osint_api/
COPY config/ ./config/

# ── Non-root user ─────────────────────────────────────────────────────────────
RUN useradd -m -u 1000 osint && \
    mkdir -p /tmp/osint-uploads /app/evidence /app/reports && \
    chown -R osint:osint /tmp/osint-uploads /app/evidence /app/reports && \
    chown -R osint:osint /app

USER osint

EXPOSE 8001
CMD ["uvicorn", "osint_api.main:app", "--host", "0.0.0.0", "--port", "8001"]
